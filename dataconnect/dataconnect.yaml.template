specVersion: "v1"
serviceId: "{{SERVICE_ID}}"
location: "{{LOCATION}}"
schema:
  source: "schema"
  datasource:
    postgresql:
      # Preserve extra application columns; use the preserving deploy script for SQL objects.
      schemaValidation: COMPATIBLE
      database: "{{DATABASE}}"
      cloudSql:
        instanceId: "{{INSTANCE_ID}}"
connectorDirs: ["connector"]
