# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# functions/.env has no secrets (just the Cloud SQL instance connection name / IAM user) and
# must be committed — Firebase Functions v2 loads it automatically at deploy time.
!functions/.env

# Firebase Functions v2 local secret values (Drive OAuth client secret/refresh token) — the
# emulator-only counterpart to real secrets in Secret Manager. Never committed.
.secret.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase
.firebase/
firebase-debug.log
firestore-debug.log
dataconnect-debug.log
pglite-debug.log
ui-debug.log
dataconnect/.dataconnect/

# cloud functions (separate npm project)
functions/node_modules
functions/lib
