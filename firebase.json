{
  "hosting": {
    "source": ".",
    "frameworksBackend": {
      "region": "us-east1"
    },
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs20",
      "ignore": [
        "node_modules",
        ".git",
        "*.local"
      ]
    }
  ],
  "dataconnect": {
    "source": "dataconnect"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "dataconnect": {
      "port": 9399,
      "postgresPort": 5432
    },
    "hosting": {
      "port": 5000
    },
    "singleProjectMode": true
  }
}
