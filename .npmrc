# firebase-tools' Next.js hosting integration (firebase-frameworks@0.11.8, its latest release)
# declares a peer on firebase-admin ^11-13, but this project uses firebase-admin@14 — a real
# version gap upstream hasn't caught up to yet, not a version we chose incorrectly. Without
# this, firebase-tools' own internal `npm install` step (building the Cloud Function bundle
# for `firebase deploy --only hosting`) fails with an ERESOLVE error before it ever gets to
# building anything.
legacy-peer-deps=true
