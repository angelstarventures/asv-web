# Loaded automatically by Firebase Functions v2 at deploy time (functions/.env convention).
# CLOUD_SQL_IAM_USER is the truncated form Cloud SQL Postgres IAM auth requires for a service
# account (".gserviceaccount.com" stripped) — must exactly match the Cloud SQL user created
# via scripts/create-function-db-user.js. Runtime SA is the default compute SA since no
# dedicated SA was configured at deploy time (345219246308-compute@developer.gserviceaccount.com).
CLOUD_SQL_INSTANCE_CONNECTION_NAME=angelstar-investments:us-east1:asv-tracker-sql
CLOUD_SQL_DATABASE=asvtrackerdb
CLOUD_SQL_IAM_USER=345219246308-compute@developer
