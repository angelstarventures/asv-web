# Loaded automatically by Firebase Functions v2 at deploy time (functions/.env convention).
# CLOUD_SQL_IAM_USER is the truncated form Cloud SQL Postgres IAM auth requires for a service
# account (".gserviceaccount.com" stripped) — must exactly match the Cloud SQL user created
# via scripts/create-function-db-user.js. Runtime SA is the default compute SA since no
# dedicated SA was configured at deploy time (345219246308-compute@developer.gserviceaccount.com).
CLOUD_SQL_INSTANCE_CONNECTION_NAME=angelstar-investments:us-east1:asv-tracker-sql
CLOUD_SQL_DATABASE=asvtrackerdb
CLOUD_SQL_IAM_USER=345219246308-compute@developer

# Deal-flow pitch intake (deals-submitPitch.ts / lib/dealsDrive.ts) — separate from every other
# Drive usage in this app (lib/drive.ts, the admin ledger-document flow), on purpose. ASV has
# no Google Workspace, so no Shared Drive is available (a bare service account has zero quota
# outside one). Instead, this is a folder in a real personal Google account's My Drive
# (angelstarventures@gmail.com), accessed via real OAuth2 (see DRIVE_OAUTH_CLIENT_ID below and
# the DRIVE_OAUTH_CLIENT_SECRET/DRIVE_OAUTH_REFRESH_TOKEN secrets) — every new pitch creates its
# own subfolder here, named after the company.
DEALS_DRIVE_ROOT_FOLDER_ID=1dymURn_6vCd-knjqm2bu9JYTdJbuwlhF

# OAuth 2.0 client for the deals-only Drive access above (Desktop app type, Google Cloud
# Console). Not sensitive by itself (client IDs are effectively public), unlike its paired
# client secret and the refresh token obtained via scripts/get-drive-oauth-token.js, which are
# real secrets — see DRIVE_OAUTH_CLIENT_SECRET/DRIVE_OAUTH_REFRESH_TOKEN, set via
# `firebase functions:secrets:set` (deployed) or functions/.secret.local (emulator), never here.
DRIVE_OAUTH_CLIENT_ID=345219246308-nm70j7ldmcsvltts4shas5v7phgcc5te.apps.googleusercontent.com

# Company-update document sharing (documents-shareCompanyUpdate.ts) — uses lib/drive.ts's own
# service-account client (the same one documents-onDriveUpload.ts already uses), NOT the deals
# OAuth client above. The folder must be shared (Editor) with the Cloud Functions runtime
# service account (345219246308-compute@developer.gserviceaccount.com) for uploads/folder
# creation to succeed, same as every other folder that service account already writes into.
COMPANY_UPDATES_DRIVE_ROOT_FOLDER_ID=1sF__Hamg8klf1XYi9d_nMDNCQBzEQIvt

# Manual per-member tax-document uploads (documents-uploadTaxDocument.ts) — same OAuth-delegated
# Drive client as the deals/company-updates folders above, one subfolder per member. Created and
# shared (reader) with the Cloud Functions runtime service account the same way.
TAX_DOCUMENTS_DRIVE_ROOT_FOLDER_ID=1bb5iz3Di1wt6fWpNWNcZbyeH0Wy4NQkT

# Tenant/branding config (functions/src/lib/tenantConfig.ts) — a new deployment overrides
# these; unset values fall back to ASV's own identity, shown here as the defaults actually in
# effect today.
# TENANT_ORG_ABBREVIATION=ASV
# TENANT_GMAIL_FROM_ADDRESS=angelstarventures@gmail.com
# TENANT_FEEDBACK_RECIPIENT=angelstarinvestments@gmail.com
# TENANT_COMPLIANCE_SCREENING_ENABLED=true
# TENANT_HALAL_TAG_LABEL=Halal
